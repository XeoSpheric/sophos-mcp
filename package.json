{
  "name": "sophos-central-mcp-server",
  "version": "0.9.0",
  "description": "MCP server for the Sophos Fusion (formerly Sophos Central) APIs, running on Cloudflare Workers",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc-rs -p tsconfig.json",
    "test": "node --import ./test/setup.ts --test 'test/**/*.test.ts'",
    "build": "wrangler deploy --dry-run --outdir dist-dry-run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "tsc-rs": "0.7.0",
    "wrangler": "4.151.0"
  }
}
